
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: #f0f3f8;
  color: #172b4d;
  font-family: Arial, sans-serif;
}

.topbar {
  background: #102b55;
  color: white;
  padding: 15px 5%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  flex-wrap: wrap;
}

.topbar h1 {
  color: #42c4ff;
  margin: 0;
}

.topbar input {
  flex: 1;
  min-width: 180px;
}

input, textarea {
  padding: 13px;
  border: 1px solid #d5dce8;
  border-radius: 9px;
  width: 100%;
  margin: 8px 0;
}

button {
  border: 0;
  background: #1269df;
  color: white;
  padding: 12px 16px;
  margin: 4px;
  border-radius: 9px;
  cursor: pointer;
  font-weight: bold;
}

button:hover {
  background: #084da9;
}

.navigation {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  background: white;
  padding: 10px;
  box-shadow: 0 2px 8px #0001;
}

.navigation button {
  background: white;
  color: #17365e;
}

.layout {
  display: grid;
  grid-template-columns: 220px minmax(0, 750px);
  justify-content: center;
  gap: 20px;
  padding: 20px;
}

.sidebar, .content {
  background: white;
  border-radius: 14px;
  padding: 20px;
}

.sidebar button {
  display: block;
  width: 100%;
  text-align: left;
  background: #eef4fc;
  color: #15345f;
}

.content {
  min-width: 0;
}

.page {
  width: 100%;
}

.hidden {
  display: none !important;
}

.quick-actions {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
  margin: 20px 0;
}

.stories {
  display: flex;
  gap: 12px;
  overflow-x: auto;
}

.story {
  background: #e6efff;
  border: 2px solid #2c8af0;
  border-radius: 14px;
  min-width: 90px;
  height: 100px;
  padding: 20px 8px;
  text-align: center;
}

.post-box, .video-card, .ad-space {
  padding: 18px;
  margin: 18px 0;
  border-radius: 12px;
  background: #f4f7fc;
}

.ad-space {
  background: #fff7e7;
  border: 1px dashed #d9a849;
  text-align: center;
}

#myVideo {
  width: 100%;
  max-height: 400px;
  background: #10172a;
  border-radius: 12px;
  margin-top: 15px;
}

footer {
  text-align: center;
  padding: 20px;
  background: #102b55;
  color: white;
}

@media(max-width: 700px) {
  .layout {
    display: block;
    padding: 10px;
  }

  .sidebar {
    display: none;
  }

  .navigation {
    position: sticky;
    top: 0;
    z-index: 5;
    overflow-x: auto;
    justify-content: flex-start;
  }

  .navigation button {
    white-space: nowrap;
  }

  .topbar {
    justify-content: center;
  }

  .quick-actions {
    grid-template-columns: 1fr 1fr;
  }
}
